{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "declarationDir": "./dist",
    "declarationMap": true,
    "lib": ["ESNext", "DOM"],
    "composite": true,
    "rootDir": "./src",
    "plugins": [{ "name": "typescript-plugin-css-modules" }]
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "../game-client"],
  "references": [
    {
      "path": "../game-client"
    }
  ]
}
