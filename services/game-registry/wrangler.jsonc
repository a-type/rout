{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prod-long-game-game-registry-service",
  "compatibility_date": "2026-04-12",
  "main": "src/index.ts",
  "account_id": "5f843fcad78a2f4e1fee091c1d6c21ab",

  "routes": [
    {
      "pattern": "registry.rout.games",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "services": [
    {
      "binding": "game--exquisite-fridge--v1",
      "service": "game--exquisite-fridge--v1",
    },
    {
      "binding": "game--garden-path--v1",
      "service": "game--garden-path--v1",
    },
    {
      "binding": "game--hearts--v1",
      "service": "game--hearts--v1",
    },
    {
      "binding": "game--heir-apparent--v1",
      "service": "game--heir-apparent--v1",
    },
    {
      "binding": "game--number-guess--v1",
      "service": "game--number-guess--v1",
    },
    {
      "binding": "game--scribble--v1",
      "service": "game--scribble--v1",
    },
  ],
}
