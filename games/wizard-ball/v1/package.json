{
  "name": "@long-game/game-wizard-ball-v1",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:ui && pnpm run build:worker",
    "build:ui": "rsbuild build",
    "build:worker": "wrangler build --config ./wrangler.jsonc",
    "dev": "pnpm run --filter @long-game/game-wizard-ball-v1 --parallel \"/dev:.*/\"",
    "dev:ui": "rsbuild dev",
    "dev:worker": "wrangler dev --config ./wrangler.jsonc --port 3503",
    "core:dev": "pnpm dev",
    "test": "vitest --passWithNoTests",
    "bench": "vitest bench"
  },
  "dependencies": {
    "@a-type/ui": "catalog:",
    "@long-game/game-wizard-ball": "workspace:*",
    "@long-game/game-client": "workspace:*",
    "@long-game/common": "workspace:*",
    "@long-game/game-api": "workspace:*",
    "@long-game/game-ui": "workspace:*",
    "@long-game/game-definition": "workspace:*",
    "@verdant-web/react-router": "catalog:",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "dayjs": "^1.11.13",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^7.6.1"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@long-game/scripts": "workspace:*",
    "@long-game/uno-config": "workspace:*",
    "@long-game/bundler-config": "workspace:*",
    "@rsbuild/core": "catalog:",
    "wrangler": "catalog:",
    "vitest": "catalog:"
  }
}
