{
  "name": "@long-game/game-number-guess-v1",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:ui && pnpm run build:worker",
    "build:ui": "vite build",
    "build:worker": "wrangler build --config ./wrangler.jsonc",
    "dev": "pnpm run --filter @long-game/game-number-guess-v1 --parallel \"/dev:.*/\"",
    "dev:ui": "vite",
    "dev:worker": "wrangler dev --config ./wrangler.jsonc --port 3500 --inspector-port 33500",
    "core:dev": "pnpm dev",
    "test": "vitest --passWithNoTests",
    "browser-test:build": "vite build --mode=test",
    "browser-test:server": "pnpm --filter @long-game/game-number-guess-v1 run \"/browser-test:run:.*/\"",
    "browser-test:server:ui": "vite preview",
    "browser-test:server:worker": "pnpm dev:worker"
  },
  "dependencies": {
    "@a-type/ui": "catalog:",
    "@long-game/game-number-guess": "workspace:*",
    "@long-game/game-client": "workspace:*",
    "@long-game/common": "workspace:*",
    "@long-game/game-api": "workspace:*",
    "@long-game/game-ui": "workspace:*",
    "@long-game/game-definition": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@long-game/scripts": "workspace:*",
    "@long-game/bundler-config": "workspace:*",
    "vite": "catalog:",
    "wrangler": "catalog:"
  }
}
