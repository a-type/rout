{
  "name": "@long-game/game-scribble-v1",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:ui && pnpm run build:worker",
    "build:ui": "vite build",
    "build:worker": "wrangler build --config ./wrangler.jsonc",
    "dev": "pnpm run --filter @long-game/game-scribble-v1 --parallel \"/dev:.*/\"",
    "dev:ui": "vite",
    "dev:worker": "wrangler dev --config ./wrangler.jsonc --port 3502 --inspector-port 33502",
    "test": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@a-type/ui": "catalog:",
    "@long-game/game-scribble": "workspace:*",
    "@long-game/game-client": "workspace:*",
    "@long-game/common": "workspace:*",
    "@long-game/game-api": "workspace:*",
    "@long-game/game-ui": "workspace:*",
    "@long-game/game-definition": "workspace:*",
    "perfect-freehand": "^1.2.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "valtio": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@long-game/scripts": "workspace:*",
    "@long-game/bundler-config": "workspace:*",
    "vite": "catalog:",
    "wrangler": "catalog:",
    "vitest": "catalog:"
  }
}
