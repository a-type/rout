{
  "name": "@long-game/game-gridlock-v1",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:ui && pnpm run build:worker",
    "build:ui": "rsbuild build",
    "build:worker": "wrangler build --config ./wrangler.jsonc",
    "dev": "pnpm run --filter @long-game/game-gridlock-v1 --parallel \"/dev:.*/\"",
    "dev:ui": "rsbuild dev",
    "dev:worker": "wrangler dev --config ./wrangler.jsonc --port 3506 --inspector-port 33506",
    "test": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@a-type/ui": "catalog:",
    "@long-game/game-gridlock": "workspace:*",
    "@long-game/game-client": "workspace:*",
    "@long-game/common": "workspace:*",
    "@long-game/game-api": "workspace:*",
    "@long-game/game-ui": "workspace:*",
    "@long-game/game-definition": "workspace:*",
    "clsx": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "valtio": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@long-game/scripts": "workspace:*",
    "@long-game/uno-config": "workspace:*",
    "@long-game/bundler-config": "workspace:*",
    "@rsbuild/core": "catalog:",
    "wrangler": "catalog:",
    "vitest": "catalog:"
  }
}
