    "@a-type/ui": "catalog:",
    "@arbor-css/core": "catalog:",
    "@clack/prompts": "0.9.0",
    "@cloudflare/workers-types": "catalog:",
    "cp-tpl": "1.0.9",
    "turbo": "2.3.3",
    "typescript": "catalog:",
    "web-push": "catalog:",
    "wrangler": "catalog:",
    "vitest": "catalog:",
    "prettier": "3.5.3",
    "change-case": "5.4.4",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.1.0",
    "@vitest/coverage-v8": "catalog:",
    "typescript-plugin-css-modules": "catalog:"
  },
  "volta": {
    "node": "24.14.1"
  }
}
